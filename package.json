{
  "name": "weave-patterner",
  "private": true,
  "version": "1.0.0",
  "description": "Free online weaving draft designer: threading, tie-up, treadling and live drawdown, WIF export for looms, 3D cloth preview, double cloth and block weaves",
  "license": "MIT",
  "author": "Stephen Skidmore (https://github.com/steves165)",
  "homepage": "https://steves165.github.io/weave-patterner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steves165/weave-patterner.git"
  },
  "bugs": {
    "url": "https://github.com/steves165/weave-patterner/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx mcp/index.ts",
    "test:e2e": "vite build && playwright test --grep-invert @3d",
    "images": "tsx scripts/brand-images.ts",
    "test:e2e:3d": "vite build && playwright test --grep @3d --workers 2",
    "test:e2e:all": "vite build && playwright test",
    "test:e2e:changed": "node scripts/e2e.mjs",
    "test:e2e:live": "E2E_BASE_URL=https://steves165.github.io/weave-patterner/ node scripts/e2e.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.59.1",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "4.1.11"
  },
  "keywords": [
    "weaving",
    "weaving draft",
    "drawdown",
    "handweaving",
    "loom",
    "WIF",
    "twill",
    "overshot",
    "double cloth",
    "textile design",
    "weave design software",
    "lift plan",
    "dobby"
  ]
}
